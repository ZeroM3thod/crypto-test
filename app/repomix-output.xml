      {/* Header */}
      <div className="mb-4 flex items-start justify-between">
        <div>
          <span className={`mb-1.5 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ${plan.badgeClass}`}>
            {plan.icon}
