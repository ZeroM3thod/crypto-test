            className={`inline-block rounded-t-xl px-3 py-1 text-[10px] font-bold uppercase tracking-wider ${
              plan.id === "elite"
                ? "bg-primary/20 text-primary"
                : "bg-foreground text-background"
            }`}
          >
            {plan.ribbon}
          </span>
        </div>
