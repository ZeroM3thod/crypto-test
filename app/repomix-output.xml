"use client";

import { useEffect, useId, useMemo, useRef, useState } from "react";
import type { ReactNode } from "react";
import { motion, useReducedMotion } from "motion/react";
import { UserShell } from "@/app/(user)/_components/user-shell";
import {
  Activity,
