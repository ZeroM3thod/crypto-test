                      </td>
                      <td className="py-3 whitespace-nowrap text-muted-foreground">
                        {tx.time}
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
      </Card>
    </div>
  );
}
