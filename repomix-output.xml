                View all <ChevronRight className="size-3.5" />
              </button>
            </div>
            <div className="flex flex-col gap-2">
              {[...REFERRAL_RECORDS].reverse().slice(0, 3).map((r) => (
                <button
                  key={r.id}
                  onClick={() => setModalRecord(r)}
