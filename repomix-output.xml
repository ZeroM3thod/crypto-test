          </Card>

          <div className="flex flex-col gap-6">
            <Card title="KYC Details">
              <div className="grid gap-4 sm:grid-cols-2">
                <SelectField
                  label="KYC Status"
                  value={user.kyc.status}
                  onChange={(v) => set("kyc", { ...user.kyc, status: v as User["kyc"]["status"] })}
