# Supabase project settings
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="paste-your-service-role-key-here"

# OTP hash salt. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET="paste-a-random-64-char-hex-secret-here"

# Email sending. Required in production. If empty in development, OTP code logs in terminal.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Crypto Invest <noreply@your-domain.com>"

# Cloudinary for KYC image uploads
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
